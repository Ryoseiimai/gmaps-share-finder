{
  "name": "gmaps-share-finder dev",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "cd worker && npm install",
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "ojisan-sagashi (dev mode)",
      "onAutoForward": "openPreview"
    }
  },
  "postAttachCommand": "echo 'Run: npm run dev   (or: make dev)'",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint"]
    }
  }
}
